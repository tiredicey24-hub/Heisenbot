#!/usr/bin/env bash
set -e
[ "$(id -u)" -eq 0 ] || exec sudo bash "$0" "$@"
. /etc/heisenbot/env
APP=/opt/heisenbot
HOLD=/etc/heisenbot/stopped
url() { curl -s -m 5 http://127.0.0.1:20241/quicktunnel | sed -n 's/.*"hostname":"\([^"]*\)".*/https:\/\/\1/p'; }
units() {
  install -m 644 "$APP"/deploy/*.service "$APP"/deploy/*.timer /etc/systemd/system/
  install -m 755 "$APP/deploy/walter" /usr/local/bin/walter
  systemctl daemon-reload
  systemctl enable -q heisenbot.service heisenbot-tunnel.service heisenbot-health.timer heisenbot-update.timer
  systemctl start heisenbot-health.timer heisenbot-update.timer
}
case "${1:-info}" in
  info) echo "Dashboard : $(url)"; echo "Password  : $HEISENBOT_PASSWORD"; echo "ntfy topic: $HEISENBOT_NTFY"; systemctl is-active heisenbot ;;
  url) url ;;
  logs) journalctl -u heisenbot -n "${2:-80}" --no-pager ;;
  status)
    echo "bot    : $(systemctl is-active heisenbot)"
    echo "tunnel : $(systemctl is-active heisenbot-tunnel)"
    echo "health : $(curl -s -m 10 http://127.0.0.1:8765/healthz || echo down)"
    echo "commit : $(sudo -u heisenbot git -C $APP rev-parse --short HEAD)"
    echo "uptime : $(uptime -p)"
    echo "disk   : $(df -h / | awk 'NR==2{print $5" used"}')"
    echo "memory : $(free -m | awk '/Mem:/{print $3"/"$2" MB"}')" ;;
  health)
    [ -f "$HOLD" ] && { echo "stopped on purpose"; exit 0; }
    ok=0
    systemctl is-active -q heisenbot-tunnel || { systemctl restart heisenbot-tunnel; ok=1; }
    if ! curl -fs -m 15 http://127.0.0.1:8765/healthz >/dev/null; then
      sleep 20
      curl -fs -m 15 http://127.0.0.1:8765/healthz >/dev/null || { systemctl restart heisenbot; ok=1; }
    fi
    [ "$ok" -eq 0 ] && echo healthy || echo "restarted"
    exit "$ok" ;;
  restart) rm -f "$HOLD"; systemctl restart heisenbot heisenbot-tunnel; sleep 8; echo "Dashboard : $(url)" ;;
  stop) touch "$HOLD"; systemctl stop heisenbot; echo "stopped until: walter start" ;;
  start) rm -f "$HOLD"; systemctl start heisenbot; echo started ;;
  update)
    sudo -u heisenbot git -C "$APP" fetch -q --depth 1 origin main
    OLD=$(sudo -u heisenbot git -C "$APP" rev-parse HEAD)
    sudo -u heisenbot git -C "$APP" reset -q --hard origin/main
    NEW=$(sudo -u heisenbot git -C "$APP" rev-parse HEAD)
    sudo -u heisenbot "$APP/.venv/bin/pip" install -q -r "$APP/requirements.txt"
    sudo -u heisenbot PLAYWRIGHT_BROWSERS_PATH="$PLAYWRIGHT_BROWSERS_PATH" "$APP/.venv/bin/python" -m playwright install chromium >/dev/null
    units
    if [ ! -f "$HOLD" ] && { [ "$OLD" != "$NEW" ] || [ "${2:-}" = "force" ]; }; then systemctl restart heisenbot; echo "updated ${OLD:0:7} -> ${NEW:0:7}"; else echo "already on ${NEW:0:7}"; fi
    [ -f "$HOLD" ] && systemctl stop heisenbot || true ;;
  password)
    NEW="${2:-$(python3 -c 'import secrets;print(secrets.token_hex(6))')}"
    sed -i "s/^HEISENBOT_PASSWORD=.*/HEISENBOT_PASSWORD=$NEW/" /etc/heisenbot/env
    systemctl restart heisenbot; echo "New password: $NEW" ;;
  *) echo "walter [info|url|status|logs [N]|health|restart|stop|start|update [force]|password NEW]" ;;
esac
