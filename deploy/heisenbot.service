[Unit]
Description=Heisenbot Walter reaction bot
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
User=heisenbot
WorkingDirectory=/opt/heisenbot
EnvironmentFile=/etc/heisenbot/env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/heisenbot/.venv/bin/python -m heisenbot ui --no-open --port 8765
Restart=always
RestartSec=10
RuntimeMaxSec=1d
TimeoutStopSec=30
KillMode=mixed
MemoryMax=1800M
Nice=5

[Install]
WantedBy=multi-user.target
